# Discord Bot Token – Discord Developer Portal'dan alınır
DISCORD_TOKEN=buraya_discord_bot_tokeninizi_yazin

# Clash Royale API Anahtarı – https://developer.clashroyale.com adresinden alınır
CR_API_KEY=buraya_clash_royale_api_anahtarinizi_yazin

# Klan Tag'i – # işareti dahil yazılır
CLAN_TAG=#KLANTAGINIZ

# Varsayılan bildirim kanalı ID'si – Discord'da kanal üzerine sağ tıklayıp "Kanal Kimliğini Kopyala"
CHANNEL_ID=000000000000000000

# Lider Rol ID'si – Discord'da rol üzerine sağ tıklayıp "Rol Kimliğini Kopyala" (Geliştirici Modu açık olmalı)
LEADER_ROLE_ID=000000000000000000
